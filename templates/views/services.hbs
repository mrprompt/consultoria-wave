<div class="container">
	<h1>Serviços</h1>
</div>
<div class="container">
	<div class="row">
		<div class="col-md-6">
			<h3>Projetos e Consultorias</h3>
			
			<ul>
				<li>
					Acústico Arquitetônico
					<ul>
						<li>Home cinema, estúdiomusical, teatro, cinema, etc.</li>
					</ul>
				</li>
				<li>
					Avaliação acústica de salas
					<ul>
						<li>Isolamento acústico</li>
						<li>Tratamento acústico</li>
					</ul>
				</li>
				<li>
					Normas
					<ul>
						<li>NBR 10.151, NBR 10.152, NBR 15.575</li>
						<li>ISO 717-1, ISO 140-4, ISO 10534-2</li>
					</ul>
				</li>
			</ul>
		</div>
		<div class="col-md-6">
			<h3>Laudo de Engenharia</h3>
			
			<ul>
				<li>
					Ruído em comunidade
					<ul>
						<li>Ruído ocupacional</li>
						<li>Mapa de ruído</li>
						<li>Avaliação de ruído de equipamentos industriais
						<li>Avaliação de materiais acústicos</li>
					</ul>
				</li>
			</ul>
		</div>
	</div>

	<hr class="clearfix">
	
	<!-- if galleries -->
	{{#if galleries}}
	
	<div class="row gallery-images">
		{{#each galleries}}
			<div class="col-sm-12 col-md-6">
				<h3>{{ name }}</h3>
				
				<div class="col-sm-12 col-md-6">
					{{#each images}}
					<div class="gallery-image">
						<img src="{{cloudinaryUrl width='300' height='300'}}" class="img-rounded">
					</div>
					{{/each}}
				</div>
				<div class="col-sm-12 col-md-6">
					{{{ content.brief }}}
				</div>
			</div>
		{{/each}}
	</div>
	{{else}}
		<!-- else -->
	<div class="alert alert-warning">
		<h3 class="text-muted">Não existem serviços cadastrados.</h3>
	</div>
	{{/if}}
</div>
