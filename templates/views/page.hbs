{{!< default}}
<div class="container">
	<div class="row">
		<h1>{{ page.name }}</h1>
	</div>
</div>
<div class="container">
	<div class="row">
		{{{page.content.extended}}}
	</div>
	
	<!-- if images -->
	{{#if page.images}}
		<div class="row portfolio">
			{{#each page.images}}
				<div class="col-sm-4 col-md-4 portfolio-item">
					<a href="{{cloudinaryUrl width='1024' height='768'}}" class="portfolio-item-link" data-rel="prettyPhoto" >
						<span class="portfolio-item-hover"></span><span class="fullscreen"><i class="fa fa-search"></i></span>
						<img src="{{cloudinaryUrl width='120' height='90'}}" alt=" " class="img-rounded thumbnail">
					</a>
					<div class="clearfix"></div>
				</div>
			{{/each}}
		</div>
	{{/if}}

	<hr class="clearfix" />
	
	<!-- comments -->
	{{#if page.enableComment}}
		<div class="row">
		<div id="disqus_thread"></div>
		<script>
			var disqus_config = function () {
				this.page.url = 'http://www.consultoriawave.com/page/{{page.key}}';  // Replace PAGE_URL with your page's canonical URL variable
				this.page.identifier = '{{page.key}}'; // Replace PAGE_IDENTIFIER with your page's unique identifier variable
			};

			(function () { // DON'T EDIT BELOW THIS LINE
				var d = document, s = d.createElement('script');
				s.src = 'https://consultoria-wave.disqus.com/embed.js';
				s.setAttribute('data-timestamp', +new Date());
				(d.head || d.body).appendChild(s);
			})();
		</script>
		<noscript>Please enable JavaScript to view the
			<a href="https://disqus.com/?ref_noscript">comments powered by Disqus.</a>
		</noscript>
		</div>
	{{/if}}
</div>
