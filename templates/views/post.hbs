{{!< default}}
<div class="container">
	<div class="row">
		<article>
			{{!-- <p><a href="/blog">&larr; back to the blog</a></p> --}}
			{{!-- <hr> --}}
			<header>
				<h1>{{data.post.title}}</h1>
				<h5>
					{{{categoryList data.post.categories prefix="Categoria: "}}}
					{{#if author.name.first}}by {{author.name.first}}{{/if}}
				</h5>
			</header>
			<div class="post">
				{{#if data.post.image}}<img src="{{{cloudinaryUrl data.post.image width=750 height=450 crop='fit' }}}" class="img-responsive">{{/if}}
				{{{data.post.content.extended}}}
			</div>
		</article>
		
		<hr class="clearfix" />
		
		<div id="disqus_thread"></div>
		
		<script>
			var disqus_config = function () {
				this.page.url = 'http://www.consultoriawave.com/blog/{{data.post.slug}}';  // Replace PAGE_URL with your page's canonical URL variable
				this.page.identifier = '{{data.post.slug}}'; // Replace PAGE_IDENTIFIER with your page's unique identifier variable
			};

			(function () { // DON'T EDIT BELOW THIS LINE
				var d = document, s = d.createElement('script');
				s.src = 'https://consultoria-wave.disqus.com/embed.js';
				s.setAttribute('data-timestamp', +new Date());
				(d.head || d.body).appendChild(s);
			})();
		</script>
		<noscript>Please enable JavaScript to view the
			<a href="https://disqus.com/?ref_noscript">comments powered by Disqus.</a>
		</noscript>
	</div>
</div>
