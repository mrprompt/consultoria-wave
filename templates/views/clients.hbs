{{!< default}}
<div class="container">
	<h1>Clientes</h1>
</div>
<div class="container">
	<div class="row gallery-images">
		<!-- if images -->
		{{#each clients.images}}
			<div class="col-xs-6 col-sm-6 col-md-2 gallery-image">
				<img src="{{cloudinaryUrl width='300' height='300'}}" class="img-rounded">
			</div>
		{{ else }}
			<!-- else -->
			<h3 class="text-muted">Não existem clientes cadastrados.</h3>
		{{/each}}
	</div>
	
	<hr class="clearfix">
</div>
