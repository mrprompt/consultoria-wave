{{!< default}}
<div class="container">
	<h2>{{clients.name}}</h2>

	<div class="row gallery-images">
		<!-- if images -->
		{{#each clients.images}}
			<div class="col-xs-4 col-sm-4 col-md-3 gallery-image">
				<img src="{{cloudinaryUrl width='300' height='300'}}" class="img-rounded">
			</div>
		{{ else }}
			<!-- else -->
			<h3 class="text-muted">Não existem clientes cadastrados.</h3>
		{{/each}}
	</div>
	
	<hr class="clearfix">
</div>
