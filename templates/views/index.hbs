{{!< default}}

<!-- Slider Start-->
<div class="fullwidthbanner-container">
	<div class="fullwidthbanner rslider">
		<ul>
			<!-- THE FIRST SLIDE -->
			<li data-delay="6000" data-masterspeed="300" data-transition="fade">
				<div class="slotholder"><img src="img/slider/slider-bg-2.jpg" data-fullwidthcentering="on" alt="Pixma"></div>
				<div class="caption list_slide lfb tp-caption start"
					 data-easing="easeOutExpo"
					 data-start="1400"
					 data-speed="1050"
					 data-y="310"
					 data-x="150">
					<div class="list-slide">
						<i class="fa fa-music slide-icon"></i>
						<h5 class="dblue"> Projetos e Consultoria em Acústica </h5>
					</div>
				</div>
				<div class="caption list_slide lfb tp-caption start"
					 data-easing="easeOutExpo"
					 data-start="1800"
					 data-speed="1200"
					 data-y="350"
					 data-x="150">
					<div class="list-slide">
						<i class="fa fa-check-square slide-icon"></i>
						<h5 class="dblue"> Laudo de Engenharia </h5>
					</div>
				</div>
				<div class="caption list_slide lfb tp-caption start"
					 data-easing="easeOutExpo"
					 data-start="2200"
					 data-speed="1350"
					 data-y="390"
					 data-x="150">
					<div class="list-slide">
						<i class="fa fa-thumbs-up slide-icon"></i>
						<h5 class="dblue"> Avaliação de Material Acústico </h5>
					</div>
				</div>
				<div class="caption list_slide lfb tp-caption start"
					 data-easing="easeOutExpo"
					 data-start="2600"
					 data-speed="1500"
					 data-y="430"
					 data-x="150">
					<div class="list-slide">
						<i class="fa fa-star slide-icon"></i>
						<h5 class="dblue"> NBR 10.151, NBR 10.152, NBR 15.575, ISO 717-1, ISO 140-4, ISO 10534-2 </h5>
					</div>
				</div>
			</li>
		</ul>
	</div>
</div>
<!-- Slider End-->

<!-- Slogan Start-->
<div class="slogan bottom-pad-small">
	<div class="container">
		<div class="row">
