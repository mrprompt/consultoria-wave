{{!< default}}

<!-- Slider Start-->
<div class="fullwidthbanner-container">
	<div class="fullwidthbanner rslider">
		<ul>
			<!-- THE FIRST SLIDE -->
			{{#each slides.images}}
			<li data-delay="1000" data-masterspeed="200" data-transition="fade">
				<div class="slotholder"><img src="{{cloudinaryUrl}}" data-fullwidthcentering="on" alt=""></div>
			</li>
			{{/each}}
		</ul>
	</div>
</div>
<!-- Slider End-->

<!-- Slogan Start-->
<div class="slogan bottom-pad-small">
	<div class="container">
		<div class="row">
			<div class="slogan-content">
				<div class="col-lg-9 col-md-9">
					<h2 class="slogan-title">Conforto acústico é o nosso compromisso. Desenvolvemos projetos acústicos de alta qualidade.</h2>
				</div>
				<div class="col-lg-3 col-md-3">
					<div class="get-started">
						<a href="/contato" class="btn btn-special btn-color pull-right">Fale conosco</a>
					</div>
				</div>
				<div class="clearfix"></div>
			</div>
		</div>
	</div>
</div>
<!-- Slogan End-->

<!-- Main Content start-->
<div class="main-content">
	<div class="container">
		<div class="row">
			<div class="col-lg-4 col-md-4 col-sm-4">
				<div class="content-box big ch-item bottom-pad-small">
					<div class="ch-info-wrap">
						<div class="ch-info">
							<div class="ch-info-front ch-img-1"><i class="fa fa-music"></i></div>
							<div class="ch-info-back"><i class="fa fa-music"></i></div>
						</div>
					</div>
					<div class="content-box-info">
						<h3>Elementos Acústicos</h3>
						<p>
							Elementos acústicos são...
						</p>
						<a href="/pagina/elementos-acu-sticos">Veja mais <i class="fa fa-angle-right"></i><i class="fa fa-angle-right"></i></a>
					</div>
				</div>
			</div>
			<div class="col-lg-4 col-md-4 col-sm-4">
				<div class="content-box big ch-item bottom-pad-small">
					<div class="ch-info-wrap">
						<div class="ch-info">
							<div class="ch-info-front ch-img-1"><i class="fa fa-headphones"></i></div>
							<div class="ch-info-back"><i class="fa fa-headphones"></i></div>
						</div>
					</div>
					<div class="content-box-info">
						<h3>Isolamento Acústico</h3>
						<p>
							Um isolamento acústico consiste...
						</p>
						<a href="/pagina/isolamento-acu-stico">Veja mais <i class="fa fa-angle-right"></i><i class="fa fa-angle-right"></i></a>
					</div>
				</div>
			</div>
			<div class="col-lg-4 col-md-4 col-sm-4">
				<div class="content-box big ch-item">
					<div class="ch-info-wrap">
						<div class="ch-info">
							<div class="ch-info-front ch-img-1"><i class="fa fa-microphone"></i></div>
							<div class="ch-info-back"><i class="fa fa-microphone"></i></div>
						</div>
					</div>
					<div class="content-box-info">
						<h3>Certidão de Tratamento Acústico</h3>
						<p>
							Um completo tratamento acústico...
						</p>
						<a href="/pagina/tratamento-acu-stico">Veja mais <i class="fa fa-angle-right"></i><i class="fa fa-angle-right"></i></a>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- Main Content end-->

<!-- Product Content Start-->
<div class="product-lead bottom-pad">
	<div class="container">
		<div class="row">
			<div class="col-md-12 col-sm-12 col-xs-12 animate_afr d3">
				<div class="app-service">
					<h3><span style="color: #000 !important; font-weight: bolder;">Wave Consultoria</span></h3>
					<p style="color: #FFF !important; font-weight: bolder;">A ideia principal da consultoria em projetos acústicos é subsidiar o cliente 
						com soluções técnicas viáveis. Todos os procedimentos de montagem, instalação, quantitativo de 
						insumos são descritos em um memorial descritivo, o qual facilita o uso das soluções propostas 
						no projeto.</p>
					<div class="divider"></div>
					<div class="learnmore">
						<a class="btn-special btn-grey" href="/pagina/profissional">Leia mais</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- Product Content end-->

<!-- Recent works start-->
<div class="bottom-pad">
	<div class="container">
		<div class="row">
			<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 animate_afl d1">
				<h3 class="title">Trabalhos recentes</h3>
			</div>
		</div>
		<div class="row">
			<div class="col-lg-12 col-md-12 col-xs-12">
				<div class="row portfolio-pad">
					{{#each portfolio}}
						{{#limit images limit=6}}
					<div class="col-lg-4 col-md-4 col-sm-4 col-xs-12 item animate_afc d3">
						<div class="portfolio-item">
							<a href="{{cloudinaryUrl width='1024' height='768'}}" class="portfolio-item-link" data-rel="prettyPhoto" >
								<span class="portfolio-item-hover"></span><span class="fullscreen"><i class="fa fa-search"></i></span><img src="{{cloudinaryUrl width='450' height='450'}}" alt=" "/>
							</a>
							<div class="clearfix"></div>
						</div>
					</div>
						{{/limit}}
					{{/each}}
				</div>
				<div class="clearfix"></div>
			</div>
		</div>
	</div>
</div>
<!-- Recent work end-->
