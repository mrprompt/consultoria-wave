				</div>
				<div class="col-lg-3 col-md-3">
					<div class="get-started">
						<a href="/contato" class="btn btn-special btn-color pull-right">Fale conosco</a>
					</div>
				</div>
				<div class="clearfix"></div>
			</div>
		</div>
	</div>
</div>
<!-- Slogan End-->

