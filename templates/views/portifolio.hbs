							<img src="{{cloudinaryUrl width='450' height='450'}}" alt=" " class="img-rounded">
						</a>
						<div class="clearfix"></div>
					</div>
				{{/each}}
			</div>
		{{/each}}
	{{else}}
		<!-- else -->
		<div class="alert alert-info">Não existem trabalhos recentes cadastrados.</div>
	{{/if}}
	
	<hr class="clearfix">

	<h2>Trabalhos Realizados</h2>
	
	<!-- if galleries -->
	{{#if realizados}}
		{{#each realizados}}
			<div class="row portfolio">
				{{#each images}}
					<div class="col-sm-4 col-md-4 portfolio-item">
						<a href="{{cloudinaryUrl width='1024' height='768'}}" class="portfolio-item-link" data-rel="prettyPhoto" >
							<span class="portfolio-item-hover"></span><span class="fullscreen"><i class="fa fa-search"></i></span>
							<img src="{{cloudinaryUrl width='450' height='450'}}" alt=" " class="img-rounded">
						</a>
						<div class="clearfix"></div>
					</div>
				{{/each}}
			</div>
		{{/each}}
	{{else}}
		<!-- else -->
		<div class="alert alert-info">Não existem trabalhos realizados cadastrados.</div>
	{{/if}}
</div>
